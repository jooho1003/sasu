# 사수(SASU) 환경 변수 템플릿
#
# 이 파일은 리포에 커밋된다 — 실제 값을 여기에 적지 마라.
# 실제 값은 .env.local 에 넣고, 배포는 Vercel 환경 변수(Production + Preview)에 넣는다.
#
# 원천: docs/PRD.md §4 "환경 변수" · docs/setup-guide.md §2
# 규칙: NEXT_PUBLIC_ 접두사는 아래 두 개뿐이다. 그 외 키가 클라이언트 번들에 들어가면 안 된다.
#       빌드 후 `grep -r "<키 앞 8자>" .next/static` 로 확인한다.

# --- Supabase (필수) ---------------------------------------------------------
# Settings → API. anon key는 클라이언트 노출이 정상(RLS가 방어), service role은 서버 전용.
# service role은 어댑터 insert · 워커 · 게스트 시드에서만 쓴다. 사용자 요청 경로에서 금지.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase 마이그레이션·시드 (로컬 실행 전용) -----------------------------
# 실제 값은 절대 이 파일에 넣지 말고 .env.local에만 넣는다.
SUPABASE_DB_URL=
SEED_LEAD_EMAIL=
SEED_LEAD_PASSWORD=
SEED_MEMBER_EMAIL=
SEED_MEMBER_PASSWORD=

# --- LLM (필수) --------------------------------------------------------------
# console.groq.com → API Keys. lib/llm.ts 가 유일한 호출 지점이다.
# 모델은 코드 상수로 고정한다(생성 openai/gpt-oss-120b · 분류 openai/gpt-oss-20b).
GROQ_API_KEY=

# --- Slack (필수) ------------------------------------------------------------
# api.slack.com/apps → OAuth & Permissions의 Bot User OAuth Token (xoxb-)
# Basic Information → App Credentials의 Signing Secret
SLACK_BOT_TOKEN=xoxb-
SLACK_SIGNING_SECRET=
# ADR-052: 서버 전용 OAuth 값. bot token은 기존 설치 이전 스크립트에서만 사용.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# 암호화 키: 암호학적 난수 32바이트의 표준 base64. 저장소/브라우저/로그에 노출 금지.
SLACK_TOKEN_ENCRYPTION_KEY=

# --- 워커 트리거 (필수) -------------------------------------------------------
# /api/jobs/run 을 호출할 때 x-jobs-secret 헤더로 넣는 값.
# Vercel Cron이든 Supabase pg_cron이든 이 헤더로만 인증한다.
JOBS_TRIGGER_SECRET=

# --- Notion (D7) -------------------------------------------------------------
# notion.so/my-integrations → Internal integration. 원칙 문서 페이지를 통합에 "공유"해야 200이 온다.
NOTION_TOKEN=

# --- Recall.ai (선택 · D6 판정에서 살아남으면) --------------------------------
# 봇 전사가 items로 안 들어오면 전사 업로드(.vtt/.txt)로 확정한다 (ADR-005).
RECALL_API_KEY=
RECALL_WEBHOOK_SECRET=

# --- 임베딩 (D2 확정) --------------------------------------------------------
# 기본 provider는 Voyage AI이며, 키는 서버 환경에만 둔다.
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4-lite
# 호환 경로를 선택할 때만 아래 키를 사용한다.
# OPENAI_API_KEY=

# --- 채용 예고편 개발 프리뷰 (선택 · 서버 전용, 기본 비활성) -----------------
# true일 때 /trailers 합성 체험만 연다. 제출용 Production에서는 활성화하지 않는다.
SASU_TRAILER_PREVIEW_ENABLED=false

# --- 공개 사이트 링크 (선택 · 서버 전용) ------------------------------------
# 비어 있거나 허용 형식이 아니면 버튼을 렌더하지 않는다.
# 문의는 https: 또는 mailto:, 영상·투표는 https:만 허용한다.
SASU_PILOT_CONTACT_URL=
SASU_DEMO_VIDEO_URL=
SASU_VOTE_URL=
# 발행된 합성 데모가 생기면 /t/<slug> 형식으로 지정한다. 프리뷰보다 우선한다.
SASU_TRAILER_DEMO_PATH=

# --- 조직 관리자 (서버 전용 · O10 검증 후 활성화) ---------------------------
# off: 라우트 비활성 / readonly: 읽기만 / on: 초대·멤버 관리 포함
SASU_ORG_ADMIN_MODE=off
# 파일럿 계정과 다른 QA 전용 계정. seed-qa-org.ts가 생성한다.
SEED_ORG_ADMIN_EMAIL=
SEED_ORG_ADMIN_PASSWORD=
SEED_INVITEE_EMAIL=
SEED_INVITEE_PASSWORD=
# E2E_ALLOW_EXTERNAL_WRITES=1과 함께 명시할 때만 운영 DB 쓰기 테스트 실행
E2E_ORG_ADMIN_DB=

SASU_TRAILER_PUBLISH_ENABLED=false
SEED_QA_LEAD_EMAIL=
SEED_QA_LEAD_PASSWORD=
E2E_TRAILER_DB=

SASU_TRAILER_SCORES_MODE=off
E2E_ASSESSMENT_DB=
E2E_BASE_URL_SCORES=

# --- 제출 전 읽기 전용 감사 ---------------------------------------------------
# 비우면 기본 파일럿 조직 ID를 사용한다. 감사 스크립트는 본문을 출력하거나 삭제하지 않는다.
SASU_SHOWCASE_ORG_ID=

# --- 원티드 심사위원 자동 로그인 데모 (서버 전용) ----------------------------
# Production에서 세 값이 모두 준비된 뒤 true로 켠다. 비밀번호는 절대 커밋하지 않는다.
# /demo는 이 계정의 세션을 발급하지만 합성 is_demo 조직만 읽고, 쓰기·LLM·외부 발신은 차단한다.
SASU_DEMO_AUTO_LOGIN_ENABLED=false
SASU_DEMO_USER_EMAIL=judge-demo@demo.sasu.team
SASU_DEMO_USER_PASSWORD=
