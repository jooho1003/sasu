# 사수(SASU) 환경 변수 템플릿
#
# 이 파일은 리포에 커밋된다 — 실제 값을 여기에 적지 마라.
# 실제 값은 .env.local 에 넣고, 배포는 Vercel 환경 변수(Production + Preview)에 넣는다.
#
# 원천: docs/PRD.md §4 "환경 변수" · docs/setup-guide.md §2
# 규칙: NEXT_PUBLIC_ 접두사는 아래 두 개뿐이다. 그 외 키가 클라이언트 번들에 들어가면 안 된다.
#       빌드 후 `grep -r "<키 앞 8자>" .next/static` 로 확인한다.

# --- Supabase (필수) ---------------------------------------------------------
# Settings → API. anon key는 클라이언트 노출이 정상(RLS가 방어), service role은 서버 전용.
# service role은 어댑터 insert · 워커 · 게스트 시드에서만 쓴다. 사용자 요청 경로에서 금지.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase 마이그레이션·시드 (로컬 실행 전용) -----------------------------
# 실제 값은 절대 이 파일에 넣지 말고 .env.local에만 넣는다.
SUPABASE_DB_URL=
SEED_LEAD_EMAIL=
SEED_LEAD_PASSWORD=
SEED_MEMBER_EMAIL=
SEED_MEMBER_PASSWORD=

# --- LLM (필수) --------------------------------------------------------------
# console.groq.com → API Keys. lib/llm.ts 가 유일한 호출 지점이다.
# 모델은 코드 상수로 고정한다(생성 openai/gpt-oss-120b · 분류 openai/gpt-oss-20b).
GROQ_API_KEY=

# --- Slack (필수) ------------------------------------------------------------
# api.slack.com/apps → OAuth & Permissions의 Bot User OAuth Token (xoxb-)
# Basic Information → App Credentials의 Signing Secret
SLACK_BOT_TOKEN=xoxb-
SLACK_SIGNING_SECRET=

# --- 워커 트리거 (필수) -------------------------------------------------------
# /api/jobs/run 을 호출할 때 x-jobs-secret 헤더로 넣는 값.
# Vercel Cron이든 Supabase pg_cron이든 이 헤더로만 인증한다.
JOBS_TRIGGER_SECRET=

# --- Notion (D7) -------------------------------------------------------------
# notion.so/my-integrations → Internal integration. 원칙 문서 페이지를 통합에 "공유"해야 200이 온다.
NOTION_TOKEN=

# --- Recall.ai (선택 · D6 판정에서 살아남으면) --------------------------------
# 봇 전사가 items로 안 들어오면 전사 업로드(.vtt/.txt)로 확정한다 (ADR-005).
RECALL_API_KEY=
RECALL_WEBHOOK_SECRET=

# --- 임베딩 (D2 확정) --------------------------------------------------------
# 기본 provider는 Voyage AI이며, 키는 서버 환경에만 둔다.
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4-lite
# 호환 경로를 선택할 때만 아래 키를 사용한다.
# OPENAI_API_KEY=

# --- 채용 예고편 개발 프리뷰 (선택 · 서버 전용, 기본 비활성) -----------------
# true일 때 /trailers 합성 체험만 연다. 제출용 Production에서는 활성화하지 않는다.
SASU_TRAILER_PREVIEW_ENABLED=false

# --- 공개 사이트 링크 (선택 · 서버 전용) ------------------------------------
# 비어 있거나 허용 형식이 아니면 버튼을 렌더하지 않는다.
# 문의는 https: 또는 mailto:, 영상·투표는 https:만 허용한다.
SASU_PILOT_CONTACT_URL=
SASU_DEMO_VIDEO_URL=
SASU_VOTE_URL=
# 발행된 합성 데모가 생기면 /t/<slug> 형식으로 지정한다. 프리뷰보다 우선한다.
SASU_TRAILER_DEMO_PATH=
