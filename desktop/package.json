{
  "name": "sasu-desktop",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "node node_modules/electron/install.js",
    "lint": "tsc --noEmit && eslint src electron.vite.config.ts vitest.config.ts",
    "test": "vitest run",
    "e2e": "node ../node_modules/@playwright/test/cli.js test --config playwright.e2e.config.ts",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "electron-updater": "6.8.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "electron@44.5.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
