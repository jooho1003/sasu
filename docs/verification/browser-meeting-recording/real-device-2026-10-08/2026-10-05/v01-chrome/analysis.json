 "sections": [
  {
   "start": 1.38,
   "end": 4.98,
   "confidence": "normal",
   "boundary_review": false,
   "text": "지금부터 실기기 녹음 검증 회의를 시작하겠습니다."
  },
  {
   "start": 6.56,
   "end": 6.84,
   "confidence": null,
   "boundary_review": false,
   "text": "오늘"
  },
  {
   "start": 6.84,
   "end": 10.62,
   "confidence": "normal",
   "boundary_review": false,
   "text": "첫 번째 안건은 다음 분기 마케팅 예산 배분입니다."
  },
  {
   "start": 12.06,
   "end": 12.54,
   "confidence": null,
   "boundary_review": false,
   "text": "지난달"
  },
  {
   "start": 12.54,
   "end": 17.06,
   "confidence": "normal",
   "boundary_review": false,
   "text": "광고 집행 결과를 보면 검색 광고의 전환율이 가장 높았습니다."
  },
  {
   "start": 18.74,
   "end": 23.18,
   "confidence": "normal",
   "boundary_review": false,
   "text": "그래서 검색 광고 예산을 20% 늘리는 방안을 제안합니다."
  },
  {
   "start": 24.82,
   "end": 25.28,
   "confidence": null,
   "boundary_review": false,
   "text": "반대로"
  },
  {
   "start": 25.28,
   "end": 28.98,
   "confidence": "normal",
   "boundary_review": false,
   "text": "오프라인 행사 예산은 절반으로 줄이는 것이 좋겠습니다."
  },
  {
   "start": 30.56,
   "end": 34.32,
   "confidence": "normal",
   "boundary_review": false,
   "text": "두번째 안건은 신입개발자 채용일정입니다."
  },
  {
   "start": 35.34,
   "end": 35.68,
   "confidence": null,
   "boundary_review": false,
   "text": "서류"
  },
  {
   "start": 35.68,
   "end": 40.5,
   "confidence": "normal",
   "boundary_review": false,
   "text": "접수는 이번주 금요일에 마감하고 다음주 화요일부터 면접을 봅니다."
  },
  {
   "start": 42,
   "end": 42.8,
   "confidence": null,
   "boundary_review": false,
   "text": "면접관은"
  },
  {
   "start": 42.8,
   "end": 45.74,
   "confidence": "normal",
   "boundary_review": false,
   "text": "각팀에서 2명씩 추천해 주시기 바랍니다."
  },
  {
   "start": 47.3,
   "end": 47.88,
   "confidence": null,
   "boundary_review": false,
   "text": "세번째"
  },
  {
   "start": 47.88,
   "end": 50.68,
   "confidence": "normal",
   "boundary_review": false,
   "text": "안건은 고객문의 응답시간 개선입니다."
  },
  {
   "start": 52.32,
   "end": 52.7,
   "confidence": null,
   "boundary_review": false,
   "text": "현재"
  },
  {
   "start": 52.7,
   "end": 56.9,
   "confidence": "normal",
   "boundary_review": false,
   "text": "평균 응답시간은 4시간인데 목표는 1시간 이내입니다."
  },
  {
   "start": 58.38,
   "end": 60.16,
   "confidence": "normal",
   "boundary_review": false,
   "text": "이를 위해 자주 묻는 질문"
  },
  {
   "start": 60.68,
   "end": 62.04,
   "confidence": "normal",
   "boundary_review": false,
   "text": "새로 정리하겠습니다."
  },
  {
   "start": 63.74,
   "end": 66.86,
   "confidence": "normal",
   "boundary_review": false,
   "text": "네 번째 안건은 사무실 이전 계획입니다."
  },
  {
   "start": 68.14,
   "end": 72.46000000000001,
   "confidence": "normal",
   "boundary_review": false,
   "text": "새 사무실은 역에서 걸어서 5분 거리에 있습니다."
  },
  {
   "start": 73.1,
   "end": 77.16,
   "confidence": "normal",
   "boundary_review": false,
   "text": "이사는 다음 달 셋째 주 토요일로 잡았습니다."
  },
  {
   "start": 77.92,
   "end": 81.72,
   "confidence": "normal",
   "boundary_review": false,
   "text": "각 팀은 이사 전날까지 짐 목록을 제출해주세요."
  },
  {
   "start": 83,
   "end": 88.24,
   "confidence": "normal",
   "boundary_review": false,
   "text": "회의실 예약 시스템도 새 사무실에 맞춰 다시 설정해야 합니다."
  },
  {
   "start": 89.16,
   "end": 94.34,
   "confidence": "normal",
   "boundary_review": false,
   "text": "주차 공간은 10대로 줄어들기 때문에 대중교통 이용을 권장합니다."
  },
  {
   "start": 95.34,
   "end": 95.8,
   "confidence": null,
   "boundary_review": false,
   "text": "점심"
  },
  {
   "start": 95.8,
   "end": 99.75999999999999,
   "confidence": "normal",
   "boundary_review": false,
   "text": "10대 지원 기준은 지금과 같게 유지하기로 했습니다."
  },
  {
   "start": 100.84,
   "end": 101.22,
   "confidence": null,
   "boundary_review": false,
   "text": "이전"
  },
  {
   "start": 101.22,
   "end": 105.96000000000001,
   "confidence": "normal",
   "boundary_review": false,
   "text": "비용은 총무팀 예산에서 처리하고 부족부는 다음 달에 정산합니다."
  },
  {
   "start": 107.38,
   "end": 111.03999999999999,
   "confidence": "normal",
   "boundary_review": false,
   "text": "회의록은 오늘 저녁까지 공유 폴더에 올려두겠습니다."
  },
  {
   "start": 112.58,
   "end": 113.1,
   "confidence": null,
   "boundary_review": false,
   "text": "질문이"
  },
  {
   "start": 113.1,
   "end": 116.58,
   "confidence": "normal",
   "boundary_review": false,
   "text": "있으면 회의가 끝난 뒤 채널에 남겨주시기 바랍니다."
  },
  {
   "start": 118.1,
   "end": 120.14,
   "confidence": "normal",
   "boundary_review": false,
   "text": "잠시 쉬었다가 남은 안건을"
  },
  {
   "start": 120.72,
   "end": 125.34,
   "confidence": "normal",
   "boundary_review": false,
   "text": "시작하겠습니다."
  },
  {
   "start": 126.34,
   "end": 130.6,
   "confidence": "normal",
   "boundary_review": false,
   "text": "다섯번째 안건은 보안교육입니다. 모든"
  },
  {
   "start": 130.6,
   "end": 135.36,
   "confidence": "normal",
   "boundary_review": false,
   "text": "직원은 이달 말까지 온라인 보안교육을 마쳐야 합니다."
  },
  {
   "start": 135.82,
   "end": 139.57999999999998,
   "confidence": "normal",
   "boundary_review": false,
   "text": "여섯번째 안건은 분기고크샵 장소 선정입니다."
  },
  {
   "start": 140.78,
   "end": 145.02,
   "confidence": "normal",
   "boundary_review": false,
   "text": "후보지는 강릉과 여수 두 곳이며 투표로 결정하겠습니다."
  },
  {
   "start": 146.36,
   "end": 150.9,
   "confidence": "normal",
   "boundary_review": false,
   "text": "마지막으로 다음 회의는 다음 주 수요일 오후 3시에 열겠습니다."
  },
  {
   "start": 152.2,
   "end": 152.48,
   "confidence": null,
